!.yarn/patches
!.yarn/releases
!.yarn/versions

# Build e cache
/.next
/out
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Variáveis de ambiente
#
# `.env*` cobre .env, .env.local, .env.production e qualquer variante futura.
# A exceção abaixo é a única forma de um arquivo de env entrar no repositório —
# e .env.example, por contrato, nunca carrega valor real.
.env*
!.env.example

